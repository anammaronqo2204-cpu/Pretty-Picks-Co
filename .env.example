# ===== PUBLIC (exposed to the browser – NEXT_PUBLIC_ prefix) =====
NEXT_PUBLIC_SITE_URL=https://prettypicks.co.za
# Meta Pixel ID – leave empty to disable tracking entirely
NEXT_PUBLIC_META_PIXEL_ID=
# Default WhatsApp number in international format, digits only (can be overridden in Admin → Settings)
NEXT_PUBLIC_WHATSAPP_NUMBER=27820000000

# ===== SERVER-ONLY (never prefix with NEXT_PUBLIC_) =====
# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string, use the pooler URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# TLS is enabled automatically when DATABASE_URL contains sslmode=require (Supabase/Neon).
# Force it with DATABASE_SSL=1, or disable with DATABASE_SSL=0.
# DATABASE_SSL=1
# DATABASE_POOL_MAX=10
# Admin lock. While unset, the admin dashboard is UNLOCKED (preview mode). Set to 1 before launch!
ADMIN_LOCKED=1
# Protects /admin/setup (first admin creation). Set a long random value in production.
ADMIN_SETUP_TOKEN=change-me-to-a-long-random-string

# Payment providers (not yet active – see README "PayFast or Yoco")
PAYFAST_ENABLED=0
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# Email notifications (not yet active – notifications currently appear in Admin → Inbox)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=hello@prettypicks.co.za
ADMIN_NOTIFY_EMAIL=
